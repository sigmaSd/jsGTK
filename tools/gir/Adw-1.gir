            <type name="utf8" c:type="const char*"/>
          </parameter>
        </parameters>
      </method>
      <method name="remove" c:identifier="adw_navigation_view_remove" version="1.4">
        <doc xml:space="preserve" filename="src/adw-navigation-view.c" line="2735">
          Removes @page from @self.

If @page is currently in the navigation stack, it will be removed once it's
popped. Otherwise, it's removed immediately.

See [method@NavigationView.add].
        </doc>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <type name="NavigationView" c:type="AdwNavigationView*"/>
          </instance-parameter>
          <parameter name="page" transfer-ownership="none">
            <type name="NavigationPage" c:type="AdwNavigationPage*"/>
          </parameter>
        </parameters>
      </method>
