    <class name="ToastOverlay" c:symbol-prefix="toast_overlay" c:type="AdwToastOverlay" parent="Gtk.Widget" final="1" glib:type-name="AdwToastOverlay" glib:get-type="adw_toast_overlay_get_type" glib:type-struct="ToastOverlayClass">
      <constructor name="new" c:identifier="adw_toast_overlay_new">
