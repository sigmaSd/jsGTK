    <interface name="AccessibleText" c:symbol-prefix="accessible_text" c:type="GtkAccessibleText" version="4.14" glib:type-name="GtkAccessibleText" glib:get-type="gtk_accessible_text_get_type" glib:type-struct="AccessibleTextInterface">
