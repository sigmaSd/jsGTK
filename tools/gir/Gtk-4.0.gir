            <type name="ListBox" c:type="GtkListBox*"/>
          </instance-parameter>
          <parameter name="row" transfer-ownership="none">
            <type name="ListBoxRow" c:type="GtkListBoxRow*"/>
          </parameter>
        </parameters>
      </method>
